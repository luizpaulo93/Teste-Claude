rules_version = '2';

// Regras do Firestore — cole este arquivo em: Firebase → Firestore Database → Regras → Publicar.
//
// Quase tudo é lido e gravado pelo servidor (Firebase Admin), que ignora estas regras e
// confere as permissões no código. O navegador do aluno só acessa direto:
//   1. o próprio progresso e favoritos (escritas frequentes, sem passar pela Vercel)
//   2. o chat e o status das aulas ao vivo (tempo real)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember() {
      return signedIn() && (request.auth.token.member == true || request.auth.token.admin == true);
    }

    // Progresso e favoritos do aluno: um único documento por pessoa (barato de ler).
    // Cada um só lê/grava o seu, com tamanho limitado; o servidor valida os valores ao ler.
    match /users/{uid}/state/main {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progress', 'favorites'])
        && request.resource.data.get('progress', {}) is map
        && request.resource.data.get('favorites', {}) is map
        && request.resource.data.get('progress', {}).size() <= 3000
        && request.resource.data.get('favorites', {}).size() <= 1000;
      allow delete: if false;
    }

    // Aulas ao vivo: alunos liberados ouvem o status e o chat em tempo real (envio é pelo servidor)
    match /live_status/{liveId} {
      allow read: if isMember();
    }
    match /live_sessions/{liveId}/messages/{messageId} {
      allow read: if isMember();
    }

    // Todo o resto: só o servidor
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

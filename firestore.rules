rules_version = '2';

// Regras do Firestore — cole este arquivo em: Firebase → Firestore Database → Regras → Publicar.
//
// Quase tudo é lido e gravado pelo servidor (Firebase Admin), que ignora estas regras e
// confere as permissões no código. O navegador do aluno só acessa direto:
//   1. o próprio progresso e favoritos (escritas frequentes, sem passar pela Vercel)
//   2. o chat e o status das aulas ao vivo (tempo real)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember() {
      return signedIn() && (request.auth.token.member == true || request.auth.token.admin == true);
    }

    // Progresso das aulas: cada aluno só lê/grava o dele, com campos limitados
    match /users/{uid}/progress/{lessonId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lesson_id', 'course_id', 'completed', 'position_sec', 'duration_sec', 'updated_at'])
        && request.resource.data.lesson_id == lessonId
        && request.resource.data.course_id is string && request.resource.data.course_id.size() <= 128
        && (!('completed' in request.resource.data) || request.resource.data.completed is bool)
        && (!('position_sec' in request.resource.data) || (request.resource.data.position_sec is int && request.resource.data.position_sec >= 0))
        && (!('duration_sec' in request.resource.data) || (request.resource.data.duration_sec is int && request.resource.data.duration_sec >= 0))
        && request.resource.data.updated_at is string && request.resource.data.updated_at.size() <= 40;
      allow delete: if false;
    }

    // Favoritos
    match /users/{uid}/favorites/{lessonId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lesson_id', 'created_at'])
        && request.resource.data.lesson_id == lessonId;
    }

    // Aulas ao vivo: alunos liberados ouvem o status e o chat em tempo real (envio é pelo servidor)
    match /live_status/{liveId} {
      allow read: if isMember();
    }
    match /live_sessions/{liveId}/messages/{messageId} {
      allow read: if isMember();
    }

    // Todo o resto: só o servidor
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).
# Se você instalou a integração Supabase na Vercel, essas variáveis já são criadas sozinhas.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Cloudflare R2 (arquivos: capas, PDFs, fotos). Passo a passo em docs/CLOUDFLARE-R2.md
# Sem estas variáveis, a plataforma usa o Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=vertice-media
R2_BUCKET_MATERIALS=vertice-materials
R2_PUBLIC_URL=https://arquivos.seudominio.com.br

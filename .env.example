# Copie para .env.local (local) ou cadastre na Vercel (Settings → Environments → Production).
# Passo a passo completo: docs/NEON.md, docs/FIREBASE.md e docs/CLOUDFLARE-R2.md

# Neon (banco de dados): a connection string com "-pooler" (as tabelas são criadas sozinhas)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Firebase — só o login (público): cole o bloco firebaseConfig inteiro, do jeito que o console mostra
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"AIza...","authDomain":"seu-projeto.firebaseapp.com","projectId":"seu-projeto","appId":"1:123:web:abc"}

# Firebase (secreto): o conteúdo inteiro do arquivo .json da conta de serviço
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"seu-projeto","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Cloudflare R2 (arquivos: capas, PDFs, fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=vertice-media
R2_BUCKET_MATERIALS=vertice-materials
R2_PUBLIC_URL=https://arquivos.seudominio.com.br
